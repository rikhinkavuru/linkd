# ============================================================================
# Linkd marketing — environment variables
# Copy to .env for local runs (never commit .env). In CI, set Variables for the
# non-secret toggles and Secrets for anything with a key/token.
# ============================================================================

# ── Site + behaviour ──
SITE_URL=https://linkddaily.com
SITE_TZ=America/New_York          # reference zone for "today's" puzzle
BACKFILL=1                        # 1 = (re)build every past page; 0 = today only

# Master gate for OUTBOUND channels (social + email). SEO pages ignore this.
AUTO_PUBLISH=0                    # 0 = queue drafts for review; 1 = publish live

# ── Per-channel toggles (1=on) — turn each on as its key lands ──
CHANNEL_SEO=1
CHANNEL_X=0
CHANNEL_BLUESKY=0
CHANNEL_REDDIT=0
CHANNEL_MASTODON=0
CHANNEL_DISCORD=0
CHANNEL_EMAIL=0

# ── X (Twitter) — OAuth 1.0a user context; app needs Read+Write ──
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Bluesky — free; use an App Password (Settings → App Passwords) ──
BLUESKY_HANDLE=linkd.bsky.social
BLUESKY_APP_PASSWORD=
# BLUESKY_PDS=https://bsky.social

# ── Reddit — "script" app (OAuth2 password grant). READ THE README FIRST ──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=                 # without "r/", a sub where self-promo is allowed
REDDIT_USER_AGENT=linkd-marketing/1.0 by u/yourname

# ── Mastodon — free; token scope write:statuses ──
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ── Discord — channel webhook URL ──
DISCORD_WEBHOOK_URL=

# ── Threads (Meta) — token scopes threads_basic, threads_content_publish ──
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── Email (pick one provider) ──
EMAIL_PROVIDER=                   # buttondown | resend (auto-detected if blank)
BUTTONDOWN_API_KEY=
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM=Linkd <hi@linkddaily.com>

# ── Analytics (Umami) ──
UMAMI_API_KEY=                    # Umami Cloud: Settings → API
# UMAMI_TOKEN=                    # self-host bearer token (alternative to API key)
# UMAMI_BASE=https://api.umami.is/v1
# UMAMI_WEBSITE_ID=cec9cd34-0d6f-4615-855b-58a0733cf115
